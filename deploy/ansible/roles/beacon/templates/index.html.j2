<!DOCTYPE html>
<!-- Managed by Ansible — see deploy/ansible/roles/beacon. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Preflight Network Beacon — {{ geo }}</title>
<style>
  :root {
    --bg: #0d1014;
    --ink: #f3ede3;
    --muted: #8b8579;
    --line: rgba(243, 237, 227, 0.10);
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: radial-gradient(120% 90% at 50% -10%, #2a1d12 0%, var(--bg) 55%);
    color: var(--ink);
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    -webkit-font-smoothing: antialiased;
  }
  main {
    width: 100%;
    max-width: 30rem;
    text-align: center;
  }
  .sun {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.75rem;
    border-radius: 50%;
    background: linear-gradient(160deg, #ffb24d 0%, #ff7a3c 55%, #e8542e 100%);
    box-shadow: 0 0 48px 6px rgba(255, 138, 60, 0.35);
  }
  h1 {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
  }
  .region {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin: 0 0 1.75rem;
  }
  .region code {
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--ink);
  }
  .rule {
    width: 40px;
    height: 1px;
    background: var(--line);
    border: 0;
    margin: 0 auto 1.5rem;
  }
  p.note {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 auto;
    max-width: 24rem;
  }
  footer {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
</head>
<body>
<main>
  <div class="sun" aria-hidden="true"></div>
  <h1>Preflight Network Beacon</h1>
  <p class="region">{{ geo }} &middot; <code>{{ pop_id }}</code></p>
  <hr class="rule">
  <p class="note">This endpoint measures connection quality for Preflight tech checks. There's nothing to see here.</p>
  <footer>Sunrise Productions</footer>
</main>
</body>
</html>
